 102: class FoldScaler:
 103:     def fit(self, x: np.ndarray, mask: np.ndarray) -&gt; "FoldScaler":
 104:         valid = x[mask]
 105:         self.median = np.nanmedian(valid, axis=0)
 106:         self.median = np.where(np.isfinite(self.median), self.median, 0.0)
 107:         filled = np.where(np.isfinite(valid), valid, self.median)
 108:         self.mean = filled.mean(axis=0)
 109:         self.std = filled.std(axis=0)
 110:         self.std = np.where(self.std &gt; 1e-8, self.std, 1.0)
 111:         return self
 112: 
 113:     def transform(self, x: np.ndarray, mask: np.ndarray) -&gt; np.ndarray:
 114:         filled = np.where(np.isfinite(x), x, self.median)
 115:         scaled = (filled - self.mean) / self.std
 116:         scaled[~mask] = 0.0
 117:         return scaled.astype(np.float32)
 118: 
 119:     def as_dict(self) -&gt; dict:
 120:         return {
 121:             "median": self.median.tolist(),
 122:             "mean": self.mean.tolist(),
 123:             "std": self.std.tolist(),
 124:         }
