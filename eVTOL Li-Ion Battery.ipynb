  49: def task_target(task: str) -&gt; tuple[str, bool, float | None]:
  50:     if task == "soh":
  51:         return "SOH_m_plus_5_pct", False, 100.0
  52:     if task in {"rul90", "rul85", "rul80"}:
  53:         return f"RUL{task[-2:]}_missions", True, None
  54:     raise KeyError(task)
  55: 
  56: 
  57: def build_sequences(
  58:     missions: pd.DataFrame,
  59:     features: list[str],
  60:     task: str,
  61: ) -&gt; dict[str, np.ndarray]:
  62:     target, _, _ = task_target(task)
  63:     xs, masks, ys, cells, mission_ids = [], [], [], [], []
  64:     for cell, cell_frame in missions.groupby("cell_id", sort=True):
  65:         cell_frame = cell_frame.sort_values("mission_id").reset_index(drop=True)
  66:         raw_x = cell_frame[features].to_numpy(np.float32)
  67:         for index in np.flatnonzero(cell_frame[target].notna().to_numpy()):
  68:             start = max(0, index - MAX_STEPS + 1)
  69:             sequence = raw_x[start : index + 1]
  70:             length = len(sequence)
  71:             padded = np.full((MAX_STEPS, len(features)), np.nan, dtype=np.float32)
  72:             mask = np.zeros(MAX_STEPS, dtype=bool)
  73:             # Right padding permits packed LSTM evaluation while preserving the
  74:             # same observed chronological window as a left-padded artifact.
  75:             padded[:length] = sequence
  76:             mask[:length] = True
  77:             xs.append(padded)
  78:             masks.append(mask)
  79:             ys.append(float(cell_frame.iloc[index][target]))
  80:             cells.append(str(cell))
  81:             mission_ids.append(int(cell_frame.iloc[index]["mission_id"]))
  82:     return {
  83:         "x": np.stack(xs),
  84:         "mask": np.stack(masks),
  85:         "y": np.asarray(ys, dtype=np.float32),
  86:         "cell": np.asarray(cells),
  87:         "mission_id": np.asarray(mission_ids, dtype=np.int64),
  88:     }
  89: 
  90: 
  91: def balanced_inner_folds(cells: np.ndarray, train_indices: np.ndarray) -&gt; dict[str, int]:
  92:     counts = pd.Series(cells[train_indices]).value_counts().to_dict()
  93:     totals = [0, 0, 0]
  94:     assignment: dict[str, int] = {}
  95:     for cell, count in sorted(counts.items(), key=lambda item: (-item[1], item[0])):
  96:         fold = min(range(3), key=lambda value: (totals[value], value))
  97:         assignment[str(cell)] = fold
  98:         totals[fold] += int(count)
  99:     return assignment
