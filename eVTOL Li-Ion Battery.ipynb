 275: def train_fold(
 276:     model_name: str,
 277:     task: str,
 278:     x: np.ndarray,
 279:     mask: np.ndarray,
 280:     y: np.ndarray,
 281:     train_indices: np.ndarray,
 282:     val_indices: np.ndarray,
 283:     output_dir: Path,
 284: ) -&gt; tuple[nn.Module, list[dict], dict]:
 285:     set_seed()
 286:     _, _, upper_bound = task_target(task)
 287:     # Absolute SOH and RUL occupy very different numeric ranges.  A target
 288:     # transform fitted only on the inner training cells prevents Huber's
 289:     # saturated gradient from turning scale into an architecture confound.
 290:     target_mean = float(y[train_indices].mean())
 291:     target_std = float(y[train_indices].std())
 292:     if target_std &lt; 1e-8:
 293:         target_std = 1.0
 294:     y_scaled = ((y - target_mean) / target_std).astype(np.float32)
 295:     model = make_model(model_name, x.shape[-1], False)
 296:     optimizer = torch.optim.Adam(model.parameters(), lr=LR, weight_decay=WEIGHT_DECAY)
 297:     scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(
 298:         optimizer, mode="min", factor=0.5, patience=3
 299:     )
 300:     loss_function = nn.SmoothL1Loss(beta=1.0)
 301:     generator = torch.Generator().manual_seed(SEED)
 302:     train_loader = DataLoader(
 303:         SequenceDataset(x, mask, y_scaled, train_indices),
 304:         batch_size=BATCH_SIZE,
 305:         shuffle=True,
 306:         generator=generator,
 307:     )
 308:     val_loader = DataLoader(
 309:         SequenceDataset(x, mask, y_scaled, val_indices),
 310:         batch_size=BATCH_SIZE,
 311:         shuffle=False,
 312:     )
 313:     best_mae = math.inf
 314:     best_epoch = -1
 315:     waiting = 0
 316:     log = []
 317:     output_dir.mkdir(parents=True, exist_ok=True)
 318:     checkpoint = output_dir / "best.pt"
 319:     start_training = time.perf_counter()
 320:     for epoch in range(1, MAX_EPOCHS + 1):
 321:         model.train()
 322:         running = 0.0
 323:         count = 0
 324:         for batch_x, batch_mask, batch_y in train_loader:
 325:             output, _, gate_logits = model(batch_x, batch_mask)
 326:             task_loss = loss_function(output, batch_y)
 327:             loss = task_loss
 328:             if gate_logits is not None:
 329:                 probability = torch.softmax(gate_logits, dim=-1)
 330:                 mean_assignment = probability.mean(dim=0)
 331:                 uniform_assignment = torch.full_like(
 332:                     mean_assignment, 1.0 / mean_assignment.numel()
 333:                 )
 334:                 balance_loss = torch.sum((mean_assignment - uniform_assignment) ** 2)
 335:                 loss = loss + MOE_BALANCE_WEIGHT * balance_loss
 336:             optimizer.zero_grad()
 337:             loss.backward()
 338:             torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
 339:             optimizer.step()
 340:             running += float(task_loss.detach()) * len(batch_y)
 341:             count += len(batch_y)
 342:         val_true, val_pred = predict(
 343:             model, val_loader, upper_bound, target_mean, target_std
 344:         )
 345:         val_mae = float(np.mean(np.abs(val_pred - val_true)))
 346:         val_rmse = float(np.sqrt(np.mean((val_pred - val_true) ** 2)))
 347:         scheduler.step(val_mae)
 348:         row = {
 349:             "epoch": epoch,
 350:             "train_huber": running / max(1, count),
 351:             "val_mae": val_mae,
 352:             "val_rmse": val_rmse,
 353:             "learning_rate": optimizer.param_groups[0]["lr"],
 354:         }
 355:         log.append(row)
 356:         if val_mae + 1e-6 &lt; best_mae:
 357:             best_mae = val_mae
 358:             best_epoch = epoch
 359:             waiting = 0
 360:             torch.save(model.state_dict(), checkpoint)
 361:         else:
 362:             waiting += 1
 363:             if waiting &gt;= EARLY_PATIENCE:
 364:                 break
 365:     model.load_state_dict(torch.load(checkpoint, map_location="cpu", weights_only=True))
 366:     info = {
 367:         "best_epoch": int(best_epoch),
 368:         "best_val_mae": float(best_mae),
 369:         "epochs_run": int(len(log)),
 370:         "training_seconds": float(time.perf_counter() - start_training),
 371:         "parameter_count": int(sum(parameter.numel() for parameter in model.parameters())),
 372:         "target_mean": target_mean,
 373:         "target_std": target_std,
 374:     }
 375:     return model, log, info
