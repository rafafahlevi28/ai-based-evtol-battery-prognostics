 391: def run(raw_dir: Path, output_dir: Path) -&gt; None:
 392:     paths = sorted(raw_dir.glob("VAH*.csv"))
 393:     if not paths:
 394:         raise FileNotFoundError(f"No VAH*.csv files in {raw_dir}")
 395:     output_dir.mkdir(parents=True, exist_ok=True)
 396:     all_rpts, all_missions, files = [], [], []
 397:     for path in paths:
 398:         rpts, missions, info = process_cell(path)
 399:         all_rpts.append(rpts)
 400:         all_missions.append(missions)
 401:         files.append(info)
 402:         print(
 403:             f"{info['cell_id']}: rows={info['rows']:,} missions={info['missions']:,} "
 404:             f"RPTs={info['valid_rpts']}",
 405:             flush=True,
 406:         )
 407: 
 408:     capacity = pd.concat(all_rpts, ignore_index=True)
 409:     missions = pd.concat(all_missions, ignore_index=True)
 410:     health = missions.loc[~missions["cell_id"].isin(EXCLUDED_HEALTH_CELLS)].copy()
 411:     capacity.to_csv(output_dir / "capacity_tests.csv", index=False)
 412:     missions.to_csv(output_dir / "mission_features_targets_superset.csv", index=False)
 413:     health.to_csv(output_dir / "health_mission_features_targets.csv", index=False)
 414: 
 415:     counts = {
 416:         "raw_cells": int(len(files)),
 417:         "missions_all_cells": int(len(missions)),
 418:         "valid_rpts_all_cells": int(len(capacity)),
 419:         "health_cells": int(health["cell_id"].nunique()),
 420:         "health_supported_rows": int(health["SOH_end_pct"].notna().sum()),
 421:         "soh_m_plus_5_rows": int(health["SOH_m_plus_5_pct"].notna().sum()),
 422:         "rul90_rows": int(health["RUL90_missions"].notna().sum()),
 423:         "rul85_rows": int(health["RUL85_missions"].notna().sum()),
 424:         "rul80_rows": int(health["RUL80_missions"].notna().sum()),
 425:         "rul90_cells": int(health.loc[health["RUL90_missions"].notna(), "cell_id"].nunique()),
 426:         "rul85_cells": int(health.loc[health["RUL85_missions"].notna(), "cell_id"].nunique()),
 427:         "rul80_cells": int(health.loc[health["RUL80_missions"].notna(), "cell_id"].nunique()),
 428:     }
 429:     manifest = {
 430:         "protocol": {
 431:             "cycle_instance": "raw cycle change or backward time",
 432:             "phase_runs": "contiguous Ns runs",
 433:             "max_valid_dt_s": 60,
 434:             "rpt": {
 435:                 "c5_abs_current_A": [0.39, 0.81],
 436:                 "minimum_fraction": 0.70,
 437:                 "start_voltage_min_V": 4.10,
 438:                 "end_or_min_voltage_max_V": 2.55,
 439:                 "minimum_span_V": 1.40,
 440:                 "capacity_Ah": [1.50, 3.75],
 441:                 "minimum_duration_s": 7200,
 442:             },
 443:             "excluded_health_cells": sorted(EXCLUDED_HEALTH_CELLS),
 444:             "SOH_target": "absolute unsmoothed SOH at mission m+5",
 445:             "RUL": "observed crossings only; event row retained; post-event rows excluded",
 446:         },
 447:         "counts": counts,
 448:         "files": files,
 449:     }
 450:     (output_dir / "reconstruction_manifest.json").write_text(
 451:         json.dumps(manifest, indent=2), encoding="utf-8"
 452:     )
 453:     print(json.dumps(counts, indent=2), flush=True)
 454: 
 455: 
 456: def main() -&gt; None:
 457:     parser = argparse.ArgumentParser(description=__doc__)
 458:     parser.add_argument("--raw-dir", type=Path, required=True)
 459:     parser.add_argument("--output-dir", type=Path, required=True)
 460:     args = parser.parse_args()
 461:     run(args.raw_dir, args.output_dir)
 462: 
 463: 
 464: if __name__ == "__main__":
 465:     main()
