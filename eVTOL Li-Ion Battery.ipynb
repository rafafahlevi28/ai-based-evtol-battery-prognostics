  42: def set_seed(seed: int = SEED) -&gt; None:
  43:     random.seed(seed)
  44:     np.random.seed(seed)
  45:     torch.manual_seed(seed)
  46:     torch.set_num_threads(min(9, max(1, torch.get_num_threads())))
