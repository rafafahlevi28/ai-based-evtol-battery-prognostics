ions.csv"</span><span class="mtk1">,&nbsp;index=</span><span class="mtk6">False</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"SUMMARY:"</span><span class="mtk1">,&nbsp;summary,&nbsp;flush=</span><span class="mtk6">True</span><span class="mtk1">)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk6">f</span><span class="mtk21">"Waktu&nbsp;model:&nbsp;</span><span class="mtk1">{(time.time()-start)/</span><span class="mtk12">60:.1f</span><span class="mtk1">}</span><span class="mtk21">&nbsp;menit"</span><span class="mtk1">,&nbsp;flush=</span><span class="mtk6">True</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk1">result&nbsp;=&nbsp;pd.DataFrame(all_metrics)</span></span><br><span><span class="mtk1">result.to_csv(OUT&nbsp;/&nbsp;</span><span class="mtk21">"table5_fast_summary.csv"</span><span class="mtk1">,&nbsp;index=</span><span class="mtk6">False</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"\n===&nbsp;TABLE&nbsp;5&nbsp;—&nbsp;FAST&nbsp;RESULTS&nbsp;==="</span><span class="mtk1">)</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(result.</span><span class="mtk15">round</span><span class="mtk1">(</span><span class="mtk12">4</span><span class="mtk1">).to_string(index=</span><span class="mtk6">False</span><span class="mtk1">))</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"\nTersimpan&nbsp;di:"</span><span class="mtk1">,&nbsp;OUT)</span></span><br></pre><colab-read-only-cell-placeholder style="display: none;"><template shadowrootmode="open"><!----><div><!--?lit$522919570$-->