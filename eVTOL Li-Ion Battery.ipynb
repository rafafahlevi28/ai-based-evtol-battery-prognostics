 196:     dt_raw = raw["time_s"].diff()
 197:     first_phase_row = raw["phase_run_id"].ne(raw["phase_run_id"].shift())
 198:     raw["large_gap"] = (~first_phase_row) &amp; dt_raw.gt(60.0)
 199:     raw["dt_s"] = dt_raw.mask(first_phase_row | dt_raw.gt(60.0), 0.0)
 200:     if raw["dt_s"].lt(0).any():
 201:         raise ValueError(f"{cell_id}: negative within-phase time difference")
 202:     raw["I_A"] = raw["I_mA"] / 1000.0
 203:     raw["abs_I_A"] = raw["I_A"].abs()
 204:     raw["power_W"] = raw["Ecell_V"] * raw["I_A"]
 205:     raw["abs_power_W"] = raw["power_W"].abs()
 206:     raw["energy_increment_Wh"] = raw["power_W"] * raw["dt_s"] / 3600.0
 207:     raw["I_times_V"] = raw["I_A"] * raw["Ecell_V"]
