 111:     phase["thermal_gain_C_per_W_s"] = np.where(
 112:         phase["mean_abs_power_W"] &gt;= 1.0,
 113:         phase["temp_slope_C_per_s"] / phase["mean_abs_power_W"],
 114:         np.nan,
 115:     )
 116:     return phase
