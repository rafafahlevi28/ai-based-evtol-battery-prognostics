 127: class SequenceDataset(Dataset):
 128:     def __init__(self, x, mask, y, indices):
 129:         self.x = torch.from_numpy(x[indices])
 130:         self.mask = torch.from_numpy(mask[indices])
 131:         self.y = torch.from_numpy(y[indices])
 132: 
 133:     def __len__(self):
