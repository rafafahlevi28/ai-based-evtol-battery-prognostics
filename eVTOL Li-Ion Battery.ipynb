--- build_reproducible_pipeline.py ---
1: #!/usr/bin/env python3
2: """CLI for the complete reproducible preprocessing/target pipeline."""
3: 
4: from __future__ import annotations
5: 
6: import argparse
7: import json
8: from pathlib import Path
9: import sys
10: 
11: 
12: REPOSITORY_ROOT = Path(__file__).resolve().parents[1]
13: if str(REPOSITORY_ROOT) not in sys.path:
14:     sys.path.insert(0, str(REPOSITORY_ROOT))
15: 
16: from evt_battery.config import PipelineConfig  # noqa: E402
17: from evt_battery.pipeline import run_pipeline  # noqa: E402
18: 
19: 
20: def parse_args() -&gt; argparse.Namespace:
21:     parser = argparse.ArgumentParser(
22:         description=(
23:             "Build cycle/RPT audits, phase and mission tables, explicit SOH/RUL "
24:             "targets, sliding-window samples, LOCO manifests, and checksums."
25:         )
26:     )
27:     parser.add_argument("--data-dir", type=Path, required=True, help="Directory containing raw VAH*.csv files")
28:     parser.add_argument(
29:         "--output-dir",
30:         type=Path,
31:         required=True,
32:         help="Empty destination directory for derived artifacts",
33:     )
34:     parser.add_argument("--pattern", default="VAH*.csv", help="Raw-cell filename glob")
35:     parser.add_argument(
36:         "--config",
37:         type=Path,
38:         default=REPOSITORY_ROOT / "config" / "pipeline.json",
39:         help="Versioned JSON pipeline configuration",
40:     )
41:     parser.add_argument(
42:         "--feature-dictionary",
43:         type=Path,
44:         default=REPOSITORY_ROOT / "feature_dictionary.csv",
45:         help="Checked-in predictor allow-list",
46:     )
47:     parser.add_argument(
48:         "--write-cleaned-telemetry",
49:         action="store_true",
50:         help="Also write large canonical row-level telemetry tables",
51:     )
52:     parser.add_argument(
53:         "--continue-on-error",
54:         action="store_true",
55:         help="Record a bad cell and continue; default is fail-fast",
56:     )
57:     return parser.parse_args()
58: 
59: 
60: def main() -&gt; None:
61:     args = parse_args()
62:     data_dir = args.data_dir.expanduser().resolve()
63:     if not data_dir.is_dir():
64:         raise FileNotFoundError(f"raw-data directory does not exist: {data_dir}")
65:     paths = sorted(data_dir.glob(args.pattern))
66:     if not paths:
67:         raise FileNotFoundError(f"no files match {args.pattern!r} in {data_dir}")
68:     config = PipelineConfig.from_json(args.config)
69:     manifest = run_pipeline(
70:         paths,
71:         output_dir=args.output_dir,
72:         feature_dictionary_path=args.feature_dictionary,
73:         config=config,
74:         write_cleaned_telemetry=args.write_cleaned_telemetry,
75:         continue_on_error=args.continue_on_error,
76:     )
77:     print(json.dumps(manifest["counts"], indent=2, sort_keys=True))
78:     print(f"Manifest: {(args.output_dir.expanduser().resolve() / 'manifest.json')}")
79: 
80: 
81: if __name__ == "__main__":
82:     main()

--- reconstruct.py ---
1: #!/usr/bin/env python3
2: """Reconstruct leakage-safe mission features and health targets from CMU telemetry.
3: 
4: This implementation follows the checked manuscript protocol rather than the
5: legacy feature CSVs in the project repository.  It deliberately keeps a
6: superset of causal mission descriptors so that the exact 20-column manifest
7: can be audited against the published tree-control metrics before neural-model
8: training.
9: """
10: 
11: from __future__ import annotations
12: 
13: import argparse
14: import hashlib
15: import json
16: from pathlib import Path
17: from typing import Iterable
18: 
19: import numpy as np
20: import pandas as pd
21: 
22: 
23: REQUIRED = [
24:     "time_s",
25:     "Ecell_V",
26:     "I_mA",
27:     "QCharge_mA_h",
28:     "QDischarge_mA_h",
29:     "Temperature__C",
30:     "cycleNumber",
31:     "Ns",
32: ]
33: 
34: EXCLUDED_HEALTH_CELLS = {"VAH06", "VAH07", "VAH09"}
35: CV_SETPOINT = {"VAH07": 4.0, "VAH23": 4.1}
36: 
37: 
38: def sha256(path: Path) -&gt; str:
39:     digest = hashlib.sha256()
40:     with path.open("rb") as handle:
41:         for block in iter(lambda: handle.read(1024 * 1024), b""):
42:             digest.update(block)
43:     return digest.hexdigest()
44: 
45: 
46: def ordered_mission(ns_values: Iterable[int]) -&gt; bool:
47:     """Return True only when 4, 5, and 6 occur in chronological order."""
48: 
49:     expected = iter((4, 5, 6))
50:     wanted = next(expected, None)
51:     for value in ns_values:
52:         if value == wanted:
53:             wanted = next(expected, None)
54:             if wanted is None:
55:                 return True
56:     return False
57: 
58: 
59: def _safe_percentile(values: pd.Series, q: float) -&gt; float:
60:     values = values.dropna().to_numpy(float)
61:     return float(np.percentile(values, q)) if len(values) else np.nan
62: 
63: 
64: def _phase_table(frame: pd.DataFrame, q0_ah: float) -&gt; pd.DataFrame:
65:     """Aggregate contiguous phase runs with causal, end-of-phase descriptors."""
66: 
67:     group = frame.groupby("phase_run_id", sort=False, observed=True)
68:     phase = group.agg(
69:         cycle_instance_id=("cycle_instance_id", "first"),
70:         raw_cycle_number=("cycleNumber", "first"),
71:         source_start=("source_row", "first"),
72:         source_end=("source_row", "last"),
73:         ns=("Ns", "first"),
74:         t_start_s=("time_s", "first"),
75:         t_end_s=("time_s", "last"),
76:         duration_s=("dt_s", "sum"),
77:         energy_Wh=("energy_increment_Wh", "sum"),
78:         n_rows=("time_s", "size"),
79:         mean_I_A=("I_A", "mean"),
80:         mean_abs_I_A=("abs_I_A", "mean"),
81:         max_abs_I_A=("abs_I_A", "max"),
82:         mean_abs_power_W=("abs_power_W", "mean"),
83:         start_voltage_V=("Ecell_V", "first"),
84:         end_voltage_V=("Ecell_V", "last"),
85:         min_voltage_V=("Ecell_V", "min"),
86:         mean_temp_C=("Temperature__C", "mean"),
87:         max_temp_C=("Temperature__C", "max"),
88:         gap_count=("large_gap", "sum"),
89:         sum_I=("I_A", "sum"),
90:         sum_V=("Ecell_V", "sum"),

