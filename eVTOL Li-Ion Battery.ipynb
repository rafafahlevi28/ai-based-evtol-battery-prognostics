      <div class="editor flex lazy-editor" style=""><pre class="lazy-virtualized" style="font-size: 14px; line-height: 19px;" tabindex="0"><pre class="lazy-gutter"></pre><pre class="monaco-colorized colab colab colab colab colab colab colab" data-lang="notebook-python"><span><span class="mtk19">from</span><span class="mtk1">&nbsp;pathlib&nbsp;</span><span class="mtk19">import</span><span class="mtk1">&nbsp;Path</span></span><br><span><span class="mtk19">import</span><span class="mtk1">&nbsp;numpy&nbsp;</span><span class="mtk19">as</span><span class="mtk1">&nbsp;np</span></span><br><span><span class="mtk19">import</span><span class="mtk1">&nbsp;pandas&nbsp;</span><span class="mtk19">as</span><span class="mtk1">&nbsp;pd</span></span><br><span><span></span></span><br><span><span class="mtk1">ROOT&nbsp;=&nbsp;Path(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"/content/Mission-Phase-Feature-Learning-for-eVTOL</span><span class="mtk21">-Battery-Prognostics-with-ML-main"</span></span><br><span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk1">phase&nbsp;=&nbsp;pd.read_csv(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;ROOT&nbsp;/&nbsp;</span><span class="mtk21">"extracted_phase_features"</span><span class="mtk1">&nbsp;/&nbsp;</span><span class="mtk21">"phase_features.csv"</span></span><br><span><span class="mtk1">)</span></span><br><span><span class="mtk1">mission&nbsp;=&nbsp;pd.read_csv(ROOT&nbsp;/&nbsp;</span><span class="mtk21">"mission_features.csv"</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Agregasikan&nbsp;energi&nbsp;dan&nbsp;durasi&nbsp;CV&nbsp;dari&nbsp;tabel&nbsp;fase</span></span><br><span><span class="mtk1">cv&nbsp;=&nbsp;(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;phase.groupby([</span><span class="mtk21">"cell_id"</span><span class="mtk1">,&nbsp;</span><span class="mtk21">"mission_id"</span><span class="mtk1">],&nbsp;as_index=</span><span class="mtk6">False</span><span class="mtk1">)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;.agg(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;cv_energy_Wh=(</span><span class="mtk21">"chg_cv_energy_Wh"</span><span class="mtk1">,&nbsp;</span><span class="mtk21">"sum"</span><span class="mtk1">),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;cv_duration_s=(</span><span class="mtk21">"chg_cv_dur_s"</span><span class="mtk1">,&nbsp;</span><span class="mtk21">"sum"</span><span class="mtk1">),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;)</span></span><br><span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Pemetaan&nbsp;untuk&nbsp;audit&nbsp;terhadap&nbsp;referensi</span></span><br><span><span class="mtk8">#&nbsp;Belum&nbsp;dianggap&nbsp;sebagai&nbsp;rekonstruksi&nbsp;independen&nbsp;s</span><span class="mtk8">etpoint.</span></span><br><span><span class="mtk1">setpoints&nbsp;=&nbsp;(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;mission.groupby(</span><span class="mtk21">"cell_id"</span><span class="mtk1">)[</span><span class="mtk21">"cv_setpoint_V"</span><span class="mtk1">]</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;.first()</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;.to_dict()</span></span><br><span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk1">cv[</span><span class="mtk21">"cv_setpoint_audit_V"</span><span class="mtk1">]&nbsp;=&nbsp;cv[</span><span class="mtk21">"cell_id"</span><span class="mtk1">].</span><span class="mtk15">map</span><span class="mtk1">(setpoints)</span></span><br><span><span></span></span><br><span><span class="mtk1">cv[</span><span class="mtk21">"proxy_recomputed"</span><span class="mtk1">]&nbsp;=&nbsp;np.where(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;cv[</span><span class="mtk21">"cv_duration_s"</span><span class="mtk1">]&nbsp;&gt;&nbsp;</span><span class="mtk12">0</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;(cv[</span><span class="mtk21">"cv_energy_Wh"</span><span class="mtk1">]&nbsp;/&nbsp;cv[</span><span class="mtk21">"cv_setpoint_audit_V"</span><span class="mtk1">])</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;/&nbsp;(cv[</span><span class="mtk21">"cv_duration_s"</span><span class="mtk1">]&nbsp;/&nbsp;</span><span class="mtk12">3600.0</span><span class="mtk1">),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;np.nan,</span></span><br><span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk1">check&nbsp;=&nbsp;cv.merge(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;mission[</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;[</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"cell_id"</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"mission_id"</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"cv_setpoint_V"</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"chg_cv_mean_I_A_proxy"</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;]</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;],</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;on=[</span><span class="mtk21">"cell_id"</span><span class="mtk1">,&nbsp;</span><span class="mtk21">"mission_id"</span><span class="mtk1">],</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;how=</span><span class="mtk21">"inner"</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;validate=</span><span class="mtk21">"one_to_one"</span><span class="mtk1">,</span></span><br><span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk1">check[</span><span class="mtk21">"abs_error"</span><span class="mtk1">]&nbsp;=&nbsp;(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;check[</span><span class="mtk21">"proxy_recomputed"</span><span class="mtk1">]&nbsp;-&nbsp;check[</span><span class="mtk21">"chg_cv_mean_I_A_proxy"</span><span class="mtk1">]</span></span><br><span><span class="mtk1">).</span><span class="mtk15">abs</span><span class="mtk1">()</span></span><br><span><span></span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"Jumlah&nbsp;baris:"</span><span class="mtk1">,&nbsp;</span><span class="mtk15">len</span><span class="mtk1">(check))</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"Jumlah&nbsp;pasangan&nbsp;cocok:"</span><span class="mtk1">,&nbsp;</span><span class="mtk15">len</span><span class="mtk1">(check))</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"MAE&nbsp;proxy:"</span><span class="mtk1">,&nbsp;check[</span><span class="mtk21">"abs_error"</span><span class="mtk1">].mean())</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"Maksimum&nbsp;galat:"</span><span class="mtk1">,&nbsp;check[</span><span class="mtk21">"abs_error"</span><span class="mtk1">].</span><span class="mtk15">max</span><span class="mtk1">())</span></span><br><span><span></span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"\nGalat&nbsp;terbesar:"</span><span class="mtk1">)</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;check.nlargest(</span><span class="mtk12">10</span><span class="mtk1">,&nbsp;</span><span class="mtk21">"abs_error"</span><span class="mtk1">)[</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;[</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"cell_id"</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"mission_id"</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"cv_setpoint_V"</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"proxy_recomputed"</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"chg_cv_mean_I_A_proxy"</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"abs_error"</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;]</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;].to_string(index=</span><span class="mtk6">False</span><span class="mtk1">)</span></span><br><span><span class="mtk1">)</span></span><br></pre><colab-read-only-cell-place