  64: class AttnGRUBase(nn.Module):
  65:     """GRU + time attention + MLP head; forward matches AttnLSTMBase signature."""
  66:     def __init__(self, d_in, d_hid: int = D_HID, n_layers: int = N_LAYERS, dropout: float = DROPOUT, nonneg_head: bool=False):
  67:         super().__init__()
  68:         self.gru = nn.GRU(d_in, d_hid, num_layers=n_layers, batch_first=True,
  69:                           dropout=dropout if n_layers&gt;1 else 0.0)
  70:         self.pool = _TimeAttentionPool(d_hid)
  71:         self.head = _Head(d_in=2*d_hid, d_hid=d_hid, dropout=dropout, nonneg=nonneg_head)
  73:     def forward(self, x, lengths, mask):
  74:         packed = pack_padded_sequence(x, lengths.cpu(), batch_first=True, enforce_sorted=False)
  75:         H, hT = self.gru(packed)
  76:         H, _  = pad_packed_sequence(H, batch_first=True)   # (B, T*, H)
  77:         if H.size(1) != mask.size(1): mask = mask[:, :H.size(1)]
  78:         hT = hT[-1]                                        # (B, H)

