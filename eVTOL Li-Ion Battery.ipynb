 158: class AttentionLSTMMoE(nn.Module):
 159:     def __init__(self, d_in: int, nonnegative: bool):
 160:         super().__init__()
 161:         self.lstm = nn.LSTM(d_in, HIDDEN, num_layers=1, batch_first=True)
 162:         self.attention = TimeAttention(HIDDEN)
 163:         self.gate = nn.Linear(2 * HIDDEN, 6)
 164:         self.experts = nn.ModuleList(
 165:             [
 166:                 nn.Sequential(
 167:                     nn.Linear(2 * HIDDEN, HIDDEN),
 168:                     nn.ReLU(),
 169:                     nn.Dropout(DROPOUT),
 170:                     nn.Linear(HIDDEN, 1),
 171:                 )
 172:                 for _ in range(6)
 173:             ]
 174:         )
 175:         self.nonnegative = nonnegative
 176: 
 177:     def forward(self, x, mask):
 178:         lengths = mask.sum(dim=1).to(torch.int64)
 179:         packed = pack_padded_sequence(x, lengths.cpu(), batch_first=True, enforce_sorted=False)
 180:         hidden_packed, (last, _) = self.lstm(packed)
 181:         hidden, _ = pad_packed_sequence(
 182:             hidden_packed, batch_first=True, total_length=x.shape[1]
 183:         )
 184:         last = last[-1]
 185:         context, attention = self.attention(hidden, last, mask)
 186:         fused = torch.cat([context, last], dim=-1)
 187:         gate_logits = self.gate(fused)
 188:         full_prob = torch.softmax(gate_logits, dim=-1)
 189:         top_value, top_index = torch.topk(full_prob, k=2, dim=-1)
 190:         sparse = torch.zeros_like(full_prob).scatter(1, top_index, top_value)
 191:         sparse = sparse / sparse.sum(dim=-1, keepdim=True).clamp_min(1e-12)
 192:         expert_output = torch.cat([expert(fused) for expert in self.experts], dim=1)
 193:         output = (sparse * expert_output).sum(dim=1)
 194:         if self.nonnegative:
 195:             output = F.softplus(output)
 196:         return output, attention, gate_logits
