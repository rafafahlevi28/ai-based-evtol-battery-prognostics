</span><span class="mtk12">2.55</span><span class="mtk1">)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&amp;&nbsp;(df[</span><span class="mtk21">"voltage_span_V"</span><span class="mtk1">]&nbsp;&gt;=&nbsp;</span><span class="mtk12">1.40</span><span class="mtk1">)</span></span><br><span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk1">checks[</span><span class="mtk21">"capacity_ok_recomputed"</span><span class="mtk1">]&nbsp;=&nbsp;df[</span><span class="mtk21">"capacity_ah"</span><span class="mtk1">].between(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk12">1.50</span><span class="mtk1">,&nbsp;</span><span class="mtk12">3.75</span><span class="mtk1">,&nbsp;inclusive=</span><span class="mtk21">"both"</span></span><br><span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk1">checks[</span><span class="mtk21">"duration_ok_recomputed"</span><span class="mtk1">]&nbsp;=&nbsp;df[</span><span class="mtk21">"discharge_duration_s"</span><span class="mtk1">]&nbsp;&gt;=&nbsp;</span><span class="mtk12">7200</span></span><br><span><span></span></span><br><span><span class="mtk1">checks[</span><span class="mtk21">"all_rules_recomputed"</span><span class="mtk1">]&nbsp;=&nbsp;checks.</span><span class="mtk15">all</span><span class="mtk1">(axis=</span><span class="mtk12">1</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"===&nbsp;Jumlah&nbsp;RPT&nbsp;==="</span><span class="mtk1">)</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"Baris&nbsp;output:"</span><span class="mtk1">,&nbsp;</span><span class="mtk15">len</span><span class="mtk1">(df))</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"Lolos&nbsp;semua&nbsp;aturan&nbs