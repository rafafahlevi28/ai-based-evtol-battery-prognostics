 107:     phase["temp_rise_C"] = phase["max_temp_C"] - phase["mean_temp_C"]
 108:     phase["temp_slope_C_per_s"] = phase["temp_rise_C"] / np.maximum(
 109:         phase["duration_s"], 1.0
