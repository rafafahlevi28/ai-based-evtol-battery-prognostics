 199: class PositionalEncoding(nn.Module):
 200:     def __init__(self, width: int, max_steps: int = MAX_STEPS):
 201:         super().__init__()
 202:         position = torch.arange(max_steps, dtype=torch.float32).unsqueeze(1)
 203:         divisor = torch.exp(
 204:             torch.arange(0, width, 2, dtype=torch.float32) * (-math.log(10000.0) / width)
 205:         )
 206:         values = torch.zeros(max_steps, width)
 207:         values[:, 0::2] = torch.sin(position * divisor)
 208:         values[:, 1::2] = torch.cos(position * divisor)
 209:         self.register_buffer("values", values.unsqueeze(0))
 210: 
 211:     def forward(self, x):
 212:         return x + self.values[:, : x.shape[1]]
