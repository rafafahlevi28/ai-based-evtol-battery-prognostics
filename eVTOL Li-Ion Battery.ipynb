 181: def process_cell(path: Path) -&gt; tuple[pd.DataFrame, pd.DataFrame, dict]:
 182:     cell_id = path.stem.upper()
 183:     raw = pd.read_csv(path, usecols=REQUIRED, low_memory=False)
 184:     for column in REQUIRED:
