 243:             dropout=DROPOUT,
 244:             activation="relu",
 245:             batch_first=True,
 246:             norm_first=True,
 247:         )
 248:         self.encoder = nn.TransformerEncoder(
 249:             layer, num_layers=1, enable_nested_tensor=False
 250:         )
 251:         self.attention = TimeAttention(HIDDEN)
 252:         self.head = nn.Sequential(
 253:             nn.Linear(2 * HIDDEN, HIDDEN),
 254:             nn.ReLU(),
 255:             nn.Dropout(DROPOUT),
 256:             nn.Linear(HIDDEN, 1),
 257:         )
 258:         self.nonnegative = nonnegative
 259: 
 260:     def forward(self, x, mask):
 261:         hidden = self.position(self.projection(x))
 262:         hidden = self.encoder(hidden, src_key_padding_mask=~mask)
 263:         lengths = mask.sum(dim=1).to(torch.int64)
 264:         last = hidden[torch.arange(len(hidden), device=hidden.device), lengths - 1]
 265:         context, attention = self.attention(hidden, last, mask)
 266:         output = self.head(torch.cat([context, last], dim=-1)).squeeze(-1)
 267:         if self.nonnegative:
 268:             output = F.softplus(output)
 269:         return output, attention, None
