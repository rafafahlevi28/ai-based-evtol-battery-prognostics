 218: class PositionalEncoding(nn.Module):
 219:     def __init__(self, width: int, max_steps: int = MAX_STEPS):
 220:         super().__init__()
 221:         position = torch.arange(max_steps, dtype=torch.float32).unsqueeze(1)
 222:         divisor = torch.exp(
 223:             torch.arange(0, width, 2, dtype=torch.float32) * (-math.log(10000.0) / width)
 224:         )
 225:         values = torch.zeros(max_steps, width)
 226:         values[:, 0::2] = torch.sin(position * divisor)
 227:         values[:, 1::2] = torch.cos(position * divisor)
 228:         self.register_buffer("values", values.unsqueeze(0))
 229: 
 230:     def forward(self, x):
 231:         return x + self.values[:, : x.shape[1]]
