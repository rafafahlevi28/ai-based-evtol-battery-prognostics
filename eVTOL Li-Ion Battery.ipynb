 215: class MissionPhaseTransformer(nn.Module):
 216:     def __init__(self, d_in: int, nonnegative: bool):
 217:         super().__init__()
 218:         self.projection = nn.Linear(d_in, HIDDEN)
 219:         self.position = PositionalEncoding(HIDDEN)
 220:         layer = nn.TransformerEncoderLayer(
 221:             d_model=HIDDEN,
 222:             nhead=4,
 223:             dim_feedforward=384,
 224:             dropout=DROPOUT,
 225:             activation="relu",
 226:             batch_first=True,
 227:             norm_first=True,
 228:         )
 229:         self.encoder = nn.TransformerEncoder(
 230:             layer, num_layers=1, enable_nested_tensor=False
 231:         )
 232:         self.attention = TimeAttention(HIDDEN)
 233:         self.head = nn.Sequential(
 234:             nn.Linear(2 * HIDDEN, HIDDEN),
 235:             nn.ReLU(),
 236:             nn.Dropout(DROPOUT),
 237:             nn.Linear(HIDDEN, 1),
 238:         )
 239:         self.nonnegative = nonnegative
 240: 
 241:     def forward(self, x, mask):
 242:         hidden = self.position(self.projection(x))
 243:         hidden = self.encoder(hidden, src_key_padding_mask=~mask)
 244:         lengths = mask.sum(dim=1).to(torch.int64)
 245:         last = hidden[torch.arange(len(hidden), device=hidden.device), lengths - 1]
 246:         context, attention = self.attention(hidden, last, mask)
 247:         output = self.head(torch.cat([context, last], dim=-1)).squeeze(-1)
 248:         if self.nonnegative:
 249:             output = F.softplus(output)
 250:         return output, attention, None
