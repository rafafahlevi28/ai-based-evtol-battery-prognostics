 511:         "worst_cell_mae": float(cell_mae.max()),
 512:         "features": features,
 513:         "history": MAX_STEPS,
 514:         "seed": SEED,
 515:         "inner_validation": "three sample-balanced cell folds; fold 0 validation",
 516:         "training": {
 517:             "optimizer": "Adam",
 518:             "learning_rate": LR,
 519:             "weight_decay": WEIGHT_DECAY,
 520:             "batch_size": BATCH_SIZE,
 521:             "max_epochs": MAX_EPOCHS,
 522:             "early_stopping_patience": EARLY_PATIENCE,
 523:             "loss": "SmoothL1 beta=1",
 524:             "moe_load_balance_weight": MOE_BALANCE_WEIGHT,
 525:             "gradient_clip": 1.0,
 526:             "target_transform": "training-cell mean/std; inverted before scoring",
 527:         },
 528:     }
 529:     return metrics, predictions, folds, logs
 530: 
 531: 
 532: def main() -&gt; None:
 533:     parser = argparse.ArgumentParser(description=__doc__)
 534:     parser.add_argument("--input", type=Path, required=True)
 535:     parser.add_argument("--output-dir", type=Path, required=True)
 536:     parser.add_argument("--manifest", choices=sorted(MANIFESTS), default="manuscript20")
 537:     parser.add_argument(
 538:         "--tasks", nargs="+", choices=["soh", "rul90", "rul85", "rul80"], default=["soh"]
 539:     )
 540:     parser.add_argument(
 541:         "--models",
 542:         nargs="+",
 543:         choices=["attention_lstm_moe", "mission_phase_transformer"],
 544:         default=["attention_lstm_moe", "mission_phase_transformer"],
 545:     )
 546:     args = parser.parse_args()
 547:     set_seed()
 548:     missions = pd.read_csv(args.input)
 549:     features = MANIFESTS[args.manifest]
 550:     args.output_dir.mkdir(parents=True, exist_ok=True)
 551:     all_metrics, all_predictions, all_folds, all_logs = [], [], [], []
 552:     for task in args.tasks:
 553:         samples = build_sequences(missions, features, task)
 554:         print(
 555:             f"Prepared {task}: N={len(samples['y'])} cells={len(np.unique(samples['cell']))}",
 556:             flush=True,
 557:         )
 558:         for model in args.models:
 559:             metrics, predictions, folds, logs = evaluate_model_task(
 560:                 samples, features, task, model, args.output_dir
 561:             )
 562:             all_metrics.append(metrics)
 563:             all_predictions.append(predictions)
 564:             all_folds.append(folds)
 565:             all_logs.append(logs)
 566:             print(json.dumps(metrics, indent=2), flush=True)
 567:     pd.concat(all_predictions, ignore_index=True).to_csv(
 568:         args.output_dir / "sequence_predictions.csv", index=False
 569:     )
 570:     pd.concat(all_logs, ignore_index=True, sort=False).to_csv(
 571:         args.output_dir / "sequence_training_logs.csv", index=False
 572:     )
 573:     pd.concat(all_folds, ignore_index=True, sort=False).to_csv(
 574:         args.output_dir / "sequence_fold_metrics.csv", index=False
 575:     )
 576:     (args.output_dir / "sequence_metrics.json").write_text(
 577:         json.dumps(all_metrics, indent=2), encoding="utf-8"
 578:     )
 579: 
 580: 
 581: if __name__ == "__main__":
 582:     main()
</pre></div></div><div></div></colab-static-output-renderer></div></div><div><div></div></div></div>
