 140: class TimeAttention(nn.Module):
 141:     def __init__(self, width: int):
 142:         super().__init__()
 143:         self.q = nn.Linear(width, width)
 144:         self.k = nn.Linear(width, width)
 145:         self.v = nn.Linear(width, width)
 146: 
 147:     def forward(self, hidden, query, mask):
 148:         q = self.q(query).unsqueeze(1)
 149:         k = self.k(hidden)
 150:         v = self.v(hidden)
 151:         logits = (q * k).sum(dim=-1) / math.sqrt(k.shape[-1])
 152:         logits = logits.masked_fill(~mask, -1e9)
 153:         weights = torch.softmax(logits, dim=1)
 154:         context = torch.bmm(weights.unsqueeze(1), v).squeeze(1)
 155:         return context, weights
