 146:         return len(self.y)
 147: 
 148:     def __getitem__(self, index):
 149:         base = (self.x[index], self.mask[index], self.y[index])
 150:         if not self.include_metadata:
 151:             return base
 152:         return (
 153:             *base,
 154:             self.cells[index],
