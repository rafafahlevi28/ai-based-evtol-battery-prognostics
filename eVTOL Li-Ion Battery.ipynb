      <div class="editor flex lazy-editor" style=""><pre tabindex="0" class="lazy-virtualized" style="font-size: 14px; line-height: 19px;"><pre class="lazy-gutter"></pre><pre class="monaco-colorized colab colab colab colab colab colab" data-lang="notebook-python"><span><span class="mtk6">!</span><span class="mtk1">pip&nbsp;-q&nbsp;install&nbsp;catboostfrom&nbsp;pathlib&nbsp;import&nbsp;Path</span></span><br><span><span class="mtk19">import</span><span class="mtk1">&nbsp;numpy&nbsp;</span><span class="mtk19">as</span><span class="mtk1">&nbsp;np</span></span><br><span><span class="mtk19">import</span><span class="mtk1">&nbsp;pandas&nbsp;</span><span class="mtk19">as</span><span class="mtk1">&nbsp;pd</span></span><br><span><span class="mtk19">from</span><span class="mtk1">&nbsp;catboost&nbsp;</span><span class="mtk19">import</span><span class="mtk1">&nbsp;CatBoostRegressor</span></span><br><span><span class="mtk19">from</span><span class="mtk1">&nbsp;sklearn.metrics&nbsp;</span><span class="mtk19">import</span><span class="mtk1">&nbsp;mean_absolute_error,&nbsp;mean_squared_error</span></span><br><span><span></span></span><br><span><span class="mtk1">SRC&nbsp;=&nbsp;Path(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"/content/drive/MyDrive/eVTOL_Table3_source_recove</span><span class="mtk21">ry/"</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"health_mission_features_targets.csv"</span></span><br><span><span class="mtk1">)</span></span><br><span><span class="mtk1">OUT&nbsp;=&nbsp;Path(</span><span class="mtk21">"/content/drive/MyDrive/eVTOL_table5_work/final_fa</span><span class="mtk21">st"</span><span class="mtk1">)</span></span><br><span><span class="mtk1">OUT.mkdir(parents=</span><span class="mtk6">True</span><span class="mtk1">,&nbsp;exist_ok=</span><span class="mtk6">True</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk1">df&nbsp;=&nbsp;pd.read_csv(SRC)</span></span><br><span><span class="mtk1">target&nbsp;=&nbsp;</span><span class="mtk21">"SOH_m_plus_5_pct"</span></span><br><span><span></span></span><br><span><span class="mtk1">excluded&nbsp;=&nbsp;{</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"cell_id"</span><span class="mtk1">,&nbsp;</span><span class="mtk21">"mission_id"</span><span class="mtk1">,&nbsp;</span><span class="mtk21">"cycle_instance_id"</span><span class="mtk1">,&nbsp;</span><span class="mtk21">"raw_cycle_number"</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"SOH_end_pct"</span><span class="mtk1">,&nbsp;</span><span class="mtk21">"SOH_m_plus_5_pct"</span><span class="mtk1">,&nbsp;</span><span class="mtk21">"SOH_drop_5_pct"</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"RUL90_event_mission"</span><span class="mtk1">,&nbsp;</span><span class="mtk21">"RUL90_observed"</span><span class="mtk1">,&nbsp;</span><span class="mtk21">"RUL90_missions"</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"RUL85_event_mission"</span><span class="mtk1">,&nbsp;</span><span class="mtk21">"RUL85_observed"</span><span class="mtk1">,&nbsp;</span><span class="mtk21">"RUL85_missions"</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"RUL80_event_mission"</span><span class="mtk1">,&nbsp;</span><span class="mtk21">"RUL80_observed"</span><span class="mtk1">,&nbsp;</span><span class="mtk21">"RUL80_missions"</span><span class="mtk1">,</span></span><br><span><span class="mtk1">}</span></span><br><span><span class="mtk1">features&nbsp;=&nbsp;[</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;c&nbsp;</span><span class="mtk19">for</span><span class="mtk1">&nbsp;c&nbsp;</span><span class="mtk6">in</span><span class="mtk1">&nbsp;df.columns</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">if</span><span class="mtk1">&nbsp;c&nbsp;</span><span class="mtk6">not</span><span class="mtk1">&nbsp;</span><span class="mtk6">in</span><span class="mtk1">&nbsp;excluded&nbsp;</span><span class="mtk6">and</span><span class="mtk1">&nbsp;pd.api.types.is_numeric_dtype(df[c])</span></span><br><span><span class="mtk1">]</span></span><br><span><span></span></span><br><span><span class="mtk1">data&nbsp;=&nbsp;df.dropna(subset=[target,&nbsp;</span><span class="mtk21">"cell_id"</span><span class="mtk1">]).copy()</span></span><br><span><span class="mtk1">X&nbsp;=&nbsp;data[features].replace([np.inf,&nbsp;-np.inf],&nbsp;np.n</span><span class="mtk1">an)</span></span><br><span><span class="mtk1">X&nbsp;=&nbsp;X.fillna(X.median())</span></span><br><span><span class="mtk1">y&nbsp;=&nbsp;data[target].astype(</span><span class="mtk14">float</span><span class="mtk1">)</span></span><br><span><span class="mtk1">groups&nbsp;=&nbsp;data[</span><span class="mtk21">"cell_id"</span><span class="mtk1">].astype(</span><span class="mtk14">str</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk1">folds,&nbsp;predictions&nbsp;=&nbsp;[],&nbsp;[]</span></span><br><span><span></span></span><br><span><span class="mtk19">for</span><span class="mtk1">&nbsp;i,&nbsp;cell&nbsp;</span><span class="mtk6">in</span><span class="mtk1">&nbsp;</span><span class="mtk15">enumerate</span><span class="mtk1">(</span><span class="mtk15">sorted</span><span class="mtk1">(groups.unique()),&nbsp;</span><span class="mtk12">1</span><span class="mtk1">):</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;tr,&nbsp;te&nbsp;=&nbsp;groups&nbsp;!=&nbsp;cell,&nbsp;groups&nbsp;==&nbsp;cell</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;model&nbsp;=&nbsp;CatBoostRegressor(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;iterations=</span><span class="mtk12">700</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;depth=</span><span class="mtk12">7</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;learning_rate=</span><span class="mtk12">0.04</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;loss_function=</span><span class="mtk21">"RMSE"</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;verbose=</span><span class="mtk6">False</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;random_seed=</span><span class="mtk12">42</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;thread_count=</span><span class="mtk12">-1</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;model.fit(X.loc[tr],&nbsp;y.loc[tr])</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;yp&nbsp;=&nbsp;model.predict(X.loc[te])</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;yt&nbsp;=&nbsp;y.loc[te].to_numpy()</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;mae&nbsp;=&nbsp;mean_absolute_error(yt,&nbsp;yp)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;rmse&nbsp;=&nbsp;np.sqrt(mean_squared_error(yt,&nbsp;yp))</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;folds.append({</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"model"</span><span class="mtk1">:&nbsp;</span><span class="mtk21">"CatBoost"</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"cell_id"</span><span class="mtk1">:&nbsp;cell,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"n_test"</span><span class="mtk1">:&nbsp;</span><span class="mtk15">len</span><span class="mtk1">(yt),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"MAE"</span><span class="mtk1">:&nbsp;mae,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"RMSE"</span><span class="mtk1">:&nbsp;rmse</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;})</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;part&nbsp;=&nbsp;data.loc[te,&nbsp;[</span><span class="mtk21">"cell_id"</span><span class="mtk1">,&nbsp;</span><span class="mtk21">"mission_id"</span><span class="mtk1">]].copy()</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;part[</span><span class="mtk21">"model"</span><span class="mtk1">]&nbsp;=&nbsp;</span><span class="mtk21">"CatBoost"</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;part[</span><span class="mtk21">"y_true"</span><span class="mtk1">]&nbsp;=&nbsp;yt</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;part[</span><span class="mtk21">"y_pred"</span><span class="mtk1">]&nbsp;=&nbsp;yp</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;predictions.append(part)</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk15">print</span><span class="mtk1">(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk6">f</span><span class="mtk21">"</span><span class="mtk1">{i</span><span class="mtk12">:02d</span><span class="mtk1">}</span><span class="mtk21">/19&nbsp;</span><span class="mtk1">{cell}</span><span class="mtk21">&nbsp;</span><span class="mtk1">|</span><span class="mtk21">&nbsp;n=</span><span class="mtk1">{</span><span class="mtk15">len</span><span class="mtk1">(yt)}</span><span class="mtk21">&nbsp;"</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk6">f</span><span class="mtk21">"</span><span class="mtk1">|</span><span class="mtk21">&nbsp;MAE=</span><span class="mtk1">{mae</span><span class="mtk12">:.4f</span><span class="mtk1">}</span><span class="mtk21">&nbsp;</span><span class="mtk1">|</span><span class="mtk21">&nbsp;RMSE=</span><span class="mtk1">{rmse</span><span class="mtk12">:.4f</span><span class="mtk1">}</span><span class="mtk21">"</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;flush=</span><span class="mtk6">True</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;)</span></span><br><span><span></span></span><br><span><span class="mtk1">fm&nbsp;=&nbsp;pd.DataFrame(folds)</span></span><br><span><span class="mtk1">pp&nbsp;=&nbsp;pd.concat(predictions,&nbsp;ignore_index=</span><span class="mtk6">True</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk1">summary&nbsp;=&nbsp;pd.DataFrame([{</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"model"</span><span class="mtk1">:&nbsp;</span><span class="mtk21">"CatBoost"</span><span class="mtk1">,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"cells"</span><span class="mtk1">:&nbsp;fm.cell_id.nunique(),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"samples"</span><span class="mtk1">:&nbsp;</span><span class="mtk15">len</span><span class="mtk1">(pp),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"pooled_MAE"</span><span class="mtk1">:&nbsp;mean_absolute_error(pp.y_true,&nbsp;pp.y_pred),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"pooled_RMSE"</span><span class="mtk1">:&nbsp;np.sqrt(mean_squared_error(pp.y_true,&nbsp;pp.y_pred)</span><span class="mtk1">),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"macro_MAE"</span><span class="mtk1">:&nbsp;fm.MAE.mean(),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"P90_cell_MAE"</span><span class="mtk1">:&nbsp;fm.MAE.quantile(</span><span class="mtk12">0.90</span><span class="mtk1">),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"worst_cell_MAE"</span><span class="mtk1">:&nbsp;fm.MAE.</span><span class="mtk15">max</span><span class="mtk1">()</span></span><br><span><span class="mtk1">}])</span></span><br><span><span></span></span><br><span><span class="mtk1">fm.to_csv(OUT&nbsp;/&nbsp;</span><span class="mtk21">"catboost_fold_metrics.csv"</span><span class="mtk1">,&nbsp;index=</span><span class="mtk6">False</span><span class="mtk1">)</span></span><br><span><span class="mtk1">pp.to_csv(OUT&nbsp;/&nbsp;</span><span class="mtk21">"catboost_predictions.csv"</span><span class="mtk1">,&nbsp;index=</span><span class="mtk6">False</span><span class="mtk1">)</span></span><br><span><span class="mtk1">summary.to_csv(OUT&nbsp;/&nbsp;</span><span class="mtk21">"catboost_summary.csv"</span><span class="mtk1">,&nbsp;index=</span><span class="mtk6">False</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"\n===&nbsp;CATBOOST&nbsp;RESULT&nbsp;==="</span><span class="mtk1">)</span>