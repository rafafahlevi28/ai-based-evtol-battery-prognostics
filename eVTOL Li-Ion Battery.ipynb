ration_source_s"</span><span class="mtk1">]&nbsp;=&nbsp;np.select(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;[</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;df[</span><span class="mtk21">"phase_family"</span><span class="mtk1">].eq(</span><span class="mtk21">"charge"</span><span class="mtk1">),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;df[</span><span class="mtk21">"phase_family"</span><span class="mtk1">].eq(</span><span class="mtk21">"flight"</span><span class="mtk1">),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;],</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;[</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;df[</span><span class="mtk21">"chg_dur_s"</span><span class="mtk1">],</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;df[</span><span class="mtk21">"dis_dur_s"</span><span class="mtk1">],</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;],</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;default=np.nan,</span></span><br><span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk1">df[</span><span class="mtk21">"duration_ratio"</span><span class="mtk1">]&nbsp;=&nbsp;(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;df[</span><span class="mtk21">"duration_source_s"</span><span class="mtk1">]</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;/&nbsp;df[</span><span class="mtk21">"duration_bounds_s"</span><span class="mtk1">].replace(</span><span class="mtk12">0</span><span class="mtk1">,&nbsp;np.nan)</span></span><br><span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Baris&nbsp;yang&nbsp;berbeda&nbsp;lebih&nbsp;dari&nbsp;10&nbsp;kali.</span></span><br><span><span clas