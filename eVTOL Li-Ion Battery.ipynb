      <div class="editor flex lazy-editor" style=""><pre class="lazy-virtualized" style="font-size: 14px; line-height: 19px;" tabindex="0"><pre class="lazy-gutter"></pre><pre class="monaco-colorized colab colab colab colab colab colab colab colab colab colab colab" data-lang="notebook-python"><span><span class="mtk19">import</span><span class="mtk1">&nbsp;numpy&nbsp;</span><span class="mtk19">as</span><span class="mtk1">&nbsp;np</span></span><br><span><span class="mtk19">import</span><span class="mtk1">&nbsp;pandas&nbsp;</span><span class="mtk19">as</span><span class="mtk1">&nbsp;pd</span></span><br><span><span class="mtk19">from</span><span class="mtk1">&nbsp;pathlib&nbsp;</span><span class="mtk19">import</span><span class="mtk1">&nbsp;Path</span></span><br><span><span></span></span><br><span><span class="mtk1">path&nbsp;=&nbsp;Path(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"/content/drive/MyDrive/eVTOL_raw_telemetry/VAH01.</span><span class="mtk21">csv"</span></span><br><span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk1">df&nbsp;=&nbsp;pd.read_csv(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;path,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;usecols=[</span><span class="mtk21">"Ecell_V"</span><span class="mtk1">,&nbsp;</span><span class="mtk21">"I_mA"</span><span class="mtk1">,&nbsp;</span><span class="mtk21">"Ns"</span><span class="mtk1">],</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;nrows=</span><span class="mtk12">100_000</span></span><br><span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk1">df[</span><span class="mtk21">"V_V"</span><span class="mtk1">]&nbsp;=&nbsp;pd.to_numeric(df[</span><span class="mtk21">"Ecell_V"</span><span class="mtk1">],&nbsp;errors=</span><span class="mtk21">"coerce"</span><span class="mtk1">)</span></span><br><span><span class="mtk1">df[</span><span class="mtk21">"I_A"</span><span class="mtk1">]&nbsp;=&nbsp;pd.to_numeric(df[</span><span class="mtk21">"I_mA"</span><span class="mtk1">],&nbsp;errors=</span><span class="mtk21">"coerce"</span><span class="mtk1">)&nbsp;/&nbsp;</span><span class="mtk12">1000</span></span><br><span><span class="mtk1">df[</span><span class="mtk21">"Ns"</span><span class="mtk1">]&nbsp;=&nbsp;pd.to_numeric(df[</span><span class="mtk21">"Ns"</span><span class="mtk1">],&nbsp;errors=</span><span class="mtk21">"coerce"</span><span class="mtk1">)</span></span><br><span><span class="mtk1">df&nbsp;=&nbsp;df.dropna(subset=[</span><span class="mtk21">"V_V"</span><span class="mtk1">,&nbsp;</span><span class="mtk21">"I_A"</span><span class="mtk1">,&nbsp;</span><span class="mtk21">"Ns"</span><span class="mtk1">])</span></span><br><span><span></span></span><br><span><span class="mtk6">def</span><span class="mtk1">&nbsp;</span><span class="mtk15">calculate_slope</span><span class="mtk1">(</span><span class="mtk16">group</span><span class="mtk1">):</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;Gunakan&nbsp;sampel&nbsp;arus&nbsp;negatif;&nbsp;diagnostik,&nbsp;bukan&nbsp;p</span><span class="mtk8">engganti</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;filter&nbsp;validitas&nbsp;fase&nbsp;di&nbsp;pipeline&nbsp;asli.</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;g&nbsp;=&nbsp;group[group[</span><span class="mtk21">"I_A"</span><span class="mtk1">]&nbsp;&lt;&nbsp;</span><span class="mtk12">-0.05</span><span class="mtk1">]</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">if</span><span class="mtk1">&nbsp;</span><span class="mtk15">len</span><span class="mtk1">(g)&nbsp;&lt;&nbsp;</span><span class="mtk12">12</span><span class="mtk1">:</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">return</span><span class="mtk1">&nbsp;pd.Series({</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"n"</span><span class="mtk1">:&nbsp;</span><span class="mtk15">len</span><span class="mtk1">(g),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"slope_V_vs_I_ohm"</span><span class="mtk1">:&nbsp;np.nan,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"negative_slope_ohm"</span><span class="mtk1">:&nbsp;np.nan</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;})</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;i&nbsp;=&nbsp;g[</span><span class="mtk21">"I_A"</span><span class="mtk1">].to_numpy(</span><span class="mtk14">float</span><span class="mtk1">)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;v&nbsp;=&nbsp;g[</span><span class="mtk21">"V_V"</span><span class="mtk1">].to_numpy(</span><span class="mtk14">float</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;denominator&nbsp;=&nbsp;np.</span><span class="mtk15">sum</span><span class="mtk1">((i&nbsp;-&nbsp;i.mean())&nbsp;**&nbsp;</span><span class="mtk12">2</span><span class="mtk1">)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">if</span><span class="mtk1">&nbsp;denominator&nbsp;&lt;=&nbsp;</span><span class="mtk12">1e-12</span><span class="mtk1">:</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;slope&nbsp;=&nbsp;np.nan</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">else</span><span class="mtk1">:</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;slope&nbsp;=&nbsp;np.</span><span class="mtk15">sum</span><span class="mtk1">((i&nbsp;-&nbsp;i.mean())&nbsp;*&nbsp;(v&nbsp;-&nbsp;v.mean()))&nbsp;/&nbsp;denominator</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk19">return</span><span class="mtk1">&nbsp;pd.Series({</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"n"</span><span class="mtk1">:&nbsp;</span><span class="mtk15">len</span><span class="mtk1">(g),</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"slope_V_vs_I_ohm"</span><span class="mtk1">:&nbsp;slope,</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk21">"negative_slope_ohm"</span><span class="mtk1">:&nbsp;-slope</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;})</span></span><br><span><span></span></span><br><span><span class="mtk1">result&nbsp;=&nbsp;(</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;df[df[</span><span class="mtk21">"Ns"</span><span class="mtk1">].isin([</span><span class="mtk12">4</span><span class="mtk1">,&nbsp;</span><span class="mtk12">5</span><span class="mtk1">,&nbsp;</span><span class="mtk12">6</span><span class="mtk1">])]</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;.groupby(</span><span class="mtk21">"Ns"</span><span class="mtk1">)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;.apply(calculate_slope,&nbsp;include_groups=</span><span class="mtk6">False</span><span class="mtk1">)</span></span><br><span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk15">print</span><span class="mtk1">(result.to_string())</span></span><br></pre><colab-read-