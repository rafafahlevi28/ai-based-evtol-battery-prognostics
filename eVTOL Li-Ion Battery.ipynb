  93: def balanced_inner_folds(cells: np.ndarray, train_indices: np.ndarray) -&gt; dict[str, int]:
  94:     counts = pd.Series(cells[train_indices]).value_counts().to_dict()
  95:     totals = [0, 0, 0]
  96:     assignment: dict[str, int] = {}
  97:     for cell, count in sorted(counts.items(), key=lambda item: (-item[1], item[0])):
  98:         fold = min(range(3), key=lambda value: (totals[value], value))
  99:         assignment[str(cell)] = fold
 100:         totals[fold] += int(count)
 101:     return assignment
 102: 
 103: 
 104: class FoldScaler:
 105:     def fit(self, x: np.ndarray, mask: np.ndarray) -&gt; "FoldScaler":
 106:         valid = x[mask]
 107:         self.median = np.nanmedian(valid, axis=0)
 108:         self.median = np.where(np.isfinite(self.median), self.median, 0.0)
 109:         filled = np.where(np.isfinite(valid), valid, self.median)
 110:         self.mean = filled.mean(axis=0)
 111:         self.std = filled.std(axis=0)
 112:         self.std = np.where(self.std &gt; 1e-8, self.std, 1.0)
 113:         return self
 114: 
 115:     def transform(self, x: np.ndarray, mask: np.ndarray) -&gt; np.ndarray:
 116:         filled = np.where(np.isfinite(x), x, self.median)
