 159: class TimeAttention(nn.Module):
 160:     def __init__(self, width: int):
 161:         super().__init__()
 162:         self.q = nn.Linear(width, width)
 163:         self.k = nn.Linear(width, width)
 164:         self.v = nn.Linear(width, width)
 165: 
 166:     def forward(self, hidden, query, mask):
 167:         q = self.q(query).unsqueeze(1)
 168:         k = self.k(hidden)
 169:         v = self.v(hidden)
 170:         logits = (q * k).sum(dim=-1) / math.sqrt(k.shape[-1])
 171:         logits = logits.masked_fill(~mask, -1e9)
 172:         weights = torch.softmax(logits, dim=1)
 173:         context = torch.bmm(weights.unsqueeze(1), v).squeeze(1)
 174:         return context, weights
